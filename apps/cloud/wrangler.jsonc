{
  // Studio publishing backend. One Worker serves two hostnames:
  //   APP_ORIGIN      share pages, sign-in, API          e.g. https://studio.example
  //   SANDBOX_ORIGIN  the published HTML itself          e.g. https://studio-usercontent.example
  // In production the sandbox must be a different registrable domain. Content is also served
  // with a CSP "sandbox" directive, so it runs in an opaque origin even in local dev.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_NAME": "Studio",
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "SANDBOX_ORIGIN": "http://localhost:8787",
    "GOOGLE_CLIENT_ID": "",
    "MAX_UPLOAD_MB": "25"
  },
  // Secrets (wrangler secret put / .dev.vars): GOOGLE_CLIENT_SECRET, SESSION_SECRET
  "d1_databases": [{ "binding": "DB", "database_name": "studio", "database_id": "local-dev-placeholder", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "studio-files" }]
}
